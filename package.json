{
    "name": "NodeTakeOver",
    "version": "0.3.3",
    "description": "A strategy game where players take over nodes on a gameboard.",
    "main": "dist/main.js",
    "scripts": {
        "test": "jest",
        "build:tools": "tsc -p tsconfig.tools.json",
        "smoke-test": "npm run build:tools && node dist-tools/smoke-test.js",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:browser": "npm run build:tools && node dist-tools/browser-test.js",
        "format": "prettier --write \"**/*.{js,ts,json,md,html,css}\"",
        "format:check": "prettier --check .",
        "lint": "eslint . --ext .js,.ts --config eslint.config.cjs",
        "lint:fix": "eslint . --ext .js,.ts --fix --config eslint.config.cjs",
        "lint:staged": "lint-staged",
        "prepare": "husky install",
        "clean": "rm -rf dist dist-tools",
        "prebuild": "npm run clean",
        "build": "mkdir -p dist && npm run build:tools && tsc && cp -r src/*.js dist/ 2>/dev/null || true && cp -r src/types dist/ 2>/dev/null || true && cp -r style.css README.md CHANGELOG.md LICENSE dist/ && node -e \"const fs=require('fs');const v=require('./package.json').version;let h=fs.readFileSync('scripts/index.prod.html','utf8');h=h.replaceAll('__APP_VERSION__',v);fs.writeFileSync('dist/index.html',h);\" && cp -r assets dist/ && cp assets/screenshot.png assets/nodetakeover-thumb-01.png assets/nodetakeover-thumb-02.webp dist/ && cp -n .gitignore dist/ 2>/dev/null || true && node dist-tools/fix-imports.js",
        "postbuild": "echo '✅ Build complete! The dist/ directory is ready for deployment.' && echo '📁 Contents of dist/:' && ls -la dist/",
        "ensure-port": "npm run build:tools && node dist-tools/scripts/ensure-port-8000.js",
        "dev": "npm run ensure-port && vite",
        "dev:static": "npm run build && npm run ensure-port && echo '🚀 Starting development server on port 8000...' && (cd dist && python3 -m http.server 8000 --directory .)",
        "deploy:prod": "bash scripts/deploy.sh",
        "preview": "vite preview --port 8000 --strictPort",
        "dev:test": "npm run build && npm test -- __tests__/Node.test.js && npm run smoke-test",
        "start": "npm run dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/david-slimp/NodeTakeOver.git"
    },
    "keywords": [],
    "author": "",
    "license": "AGPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/david-slimp/NodeTakeOver/issues"
    },
    "homepage": "https://github.com/david-slimp/NodeTakeOver#readme",
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/plugin-transform-runtime": "^7.28.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-typescript": "^7.27.1",
        "@eslint/js": "^9.32.0",
        "@testing-library/dom": "^9.3.1",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.2.0",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "babel-jest": "^29.7.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.10.0",
        "eslint-plugin-jsdoc": "^52.0.2",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^16.1.4",
        "prettier": "^3.6.2",
        "puppeteer": "^24.15.0",
        "vite": "^5.4.0",
        "typescript": "^5.9.2"
    },
    "lint-staged": {
        "*.{js,ts}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{html,css,md,json}": [
            "prettier --write"
        ]
    }
}
