{
    "name": "NodeTakeOver",
    "version": "0.3.0",
    "description": "A strategy game where players take over nodes on a gameboard.",
    "main": "main.js",
    "scripts": {
        "test": "jest",
        "smoke-test": "node smoke-test.js",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:browser": "node browser-test.js",
        "format": "prettier --write \"**/*.{js,ts,json,md,html,css}\"",
        "format:check": "prettier --check .",
        "lint": "eslint . --ext .js,.ts --config eslint.config.cjs",
        "lint:fix": "eslint . --ext .js,.ts --fix --config eslint.config.cjs",
        "prepare": "husky install",
        "clean": "rm -rf dist",
        "prebuild": "npm run clean && tsc",
        "build": "mkdir -p dist && tsc && cp -r src/*.js dist/ 2>/dev/null || true && cp -r src/types dist/ 2>/dev/null || true && cp -r index.html style.css screenshot.png README.md CHANGELOG.md LICENSE dist/ && cp main.js dist/ 2>/dev/null || true && (cp -r assets/ dist/ 2>/dev/null || true) && cp -n .gitignore dist/ 2>/dev/null || true && node fix-imports.js",
        "postbuild": "echo '✅ Build complete! The dist/ directory is ready for deployment.' && echo '📁 Contents of dist/:' && ls -la dist/",
        "ensure-port": "node scripts/ensure-port-8000.js",
        "dev": "npm run build && npm run ensure-port && echo '🚀 Starting development server on port 8000...' && (cd dist && python3 -m http.server 8000 --directory .)",
        "dev:test": "npm run build && npm test -- __tests__/Node.test.js && npm run smoke-test",
        "start": "npm run dev"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/david-slimp/NodeTakeOver.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/david-slimp/NodeTakeOver/issues"
    },
    "homepage": "https://github.com/david-slimp/NodeTakeOver#readme",
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/plugin-transform-runtime": "^7.28.0",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-typescript": "^7.27.1",
        "@eslint/js": "^9.32.0",
        "@testing-library/dom": "^9.3.1",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/user-event": "^14.6.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.2.0",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "@typescript-eslint/parser": "^8.39.0",
        "babel-jest": "^29.7.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.10.0",
        "eslint-plugin-jsdoc": "^52.0.2",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^16.1.4",
        "prettier": "^3.6.2",
        "puppeteer": "^24.15.0",
        "typescript": "^5.9.2"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.html": [
            "prettier --write"
        ]
    }
}
