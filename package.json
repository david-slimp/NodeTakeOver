{
    "name": "NodeTakeOver",
    "version": "0.2.2",
    "description": "A strategy game where players take over nodes on a gameboard.",
    "main": "main.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --ext .js --config eslint.config.js",
        "lint:fix": "eslint . --ext .js --fix --config eslint.config.js",
        "prepare": "husky install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/david-slimp/NodeTakeOver.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/david-slimp/NodeTakeOver/issues"
    },
    "homepage": "https://github.com/david-slimp/NodeTakeOver#readme",
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "husky": "^9.1.7",
        "lint-staged": "^16.1.4",
        "prettier": "^3.6.2"
    },
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.html": [
            "prettier --write"
        ]
    }
