{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist-tools",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "fix-imports.ts",
    "smoke-test.ts",
    "browser-test.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-tools", "src", "coverage", "drafts", "__tests__"]
}

